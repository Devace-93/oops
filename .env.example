# ─── oops environment ───────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.

# --- Core / database ---
DATABASE_URL=postgresql+psycopg://oops:oops@postgres:5432/oops
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-access-secret
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# --- URLs ---
APP_BASE_URL=http://localhost:8084          # https://oops.3m4.net in prod
DASHBOARD_URL=http://localhost:8084         # same host as the apex (single-host app)

# --- Billing (RevenueCat). Self-host: set BILLING_ENABLED=false ---
BILLING_ENABLED=true
REVENUECAT_WEBHOOK_AUTH_TOKEN=change-me-webhook-token
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=

# --- PostHog (optional; no-ops if unset) ---
# Leave EMPTY locally and for self-host: no analytics calls, and oops' own
# feature switches resolve to their self-host values in
# packages/shared/feature_flags.json. Set only in production, where PostHog is
# the control panel. One PostHog project is shared with the other 3m4 apps, so
# every PostHog flag key is prefixed (POSTHOG_FLAG_PREFIX + key).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_FLAG_PREFIX=oops-
# Pin individual switches from the environment, beating both PostHog and the
# self-host defaults. Comma-separated key=on|off, e.g.
# FEATURE_FLAG_OVERRIDES=site-building=on,signups=off
FEATURE_FLAG_OVERRIDES=

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_PUBLIC_API=60/minute
# Ingest: per (project public key, client IP). A broken deploy reports in bursts.
RATE_LIMIT_INGEST=600/minute

# --- Privacy ---
# Raw IPs are not stored by default (per-project store_ip opts in):
# sha256(ip + daily salt derived from this secret) is kept instead.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
IP_HASH_SECRET=change-me-ip-hash-secret
# Minutes that count as "live" for the live-events counter.
LIVE_WINDOW_MIN=5

# --- Frontend (Vite, build-time). Prefix MUST be VITE_ ---
VITE_API_URL=http://localhost:8084/api
VITE_APP_URL=http://localhost:8084
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_REVENUECAT_PUBLIC_KEY=
VITE_BILLING_ENABLED=true
# Apps index linked from the footer (same across all 3m4 apps)
VITE_INFO_URL=https://info.3m4.net
# oops web analytics (https://oops.3m4.net): the project's PUBLIC key. Empty = no tracker.
VITE_METRICS_PROJECT_KEY=
VITE_METRICS_TRACKER_URL=https://metrics.3m4.net/m.js
# oops error tracking of oops itself (dogfooding): the oops project's PUBLIC key. Empty = no SDK.
# The SDK defaults to this app's own /o.js (same host).
VITE_OOPS_PROJECT_KEY=
VITE_OOPS_SDK_URL=/o.js
VITE_OOPS_ENV=production

# Password of the compose postgres service (must match DATABASE_URL). Default: oops
POSTGRES_PASSWORD=oops
